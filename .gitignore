# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent / playwright captures
.playwright-screenshots/

# Unblurred Dialogue interview frames (build-time only; never commit)
/private/dialogue-placement-raw/

# Copied from node_modules/hls.js on next config load. See next.config.mjs.
/public/vendor/

# Dinamo ABC Areal (hosted via NEXT_PUBLIC_AREAL_URL; never commit binaries)
/fonts/ABCAreal*
/public/fonts/ABCAreal*

# Playwright MCP scratch output
.playwright-mcp/
# ABC Areal variable woff2. Dinamo EULA §10 forbids putting the fonts in
# public repositories. next/font/local still loads this path when the file
# is present on disk (local dev / screenshots).
/fonts/ABCArealVariable.woff2
/fonts/ABCAreal*.woff2
/fonts/ABCAreal*.ttf
