   font-size: var(--font-size-xs);
@@ -37,19 +40,91 @@
   white-space: nowrap;
   min-height: 22px;
   flex-shrink: 0;
+  cursor: pointer;
+  /* Label colour is pinned on the urgency classes; do not transition colour on hover */
+  color: var(--color-text-secondary);
+  box-shadow: inset 0 0 0 1px transparent;
+  transition: box-shadow var(--transition-fast);
+}
+
+.label {
+  line-height: 1.2;
+  color: inherit;
+  opacity: 1;
+}
+
+/* Reserve chevron width so the badge does not jump on hover */
+.chevron {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 8px;
+  height: 8px;
+  flex-shrink: 0;
+  opacity: 0;
+  color: currentColor;
+  transition: opacity var(--transition-fast);
+  /* Isolate so chevron opacity never paints the label */
+  isolation: isolate;
+}
+
+.badge:hover,
+.badge:focus-visible,
+.badge:active {
+  /* Keep the same label colour as rest — no fade, no token swap */
+  color: var(--color-text-secondary);
+  /* 1px inset ring at currentColor ~45% — readable on all three fills */
+  box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 45%, transparent);
+}
+
+.badge:hover .label,
+.badge:focus-visible .label,
+.badge:active .label {
+  color: inherit;
+  opacity: 1;
+}
+
+.badge:hover .chevron,
+.badge:focus-visible .chevron {
+  opacity: 1;
+}
+
+/* Touch: chevron always visible at reduced opacity (no hover) */
+@media (hover: none) {
+  .chevron {
+    opacity: 0.45;
+  }
+
+  .badge:hover .chevron,
+  .badge:focus-visible .chevron {
+    opacity: 0.45;
+  }
+
+  .badgeEmpty {
+    opacity: 0.55;
+  }
 }
 
