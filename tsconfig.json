{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor/joola-b2b-live/scripts/**",
    "vendor/joola-b2b-live/src/main.tsx",
    "vendor/joola-b2b-live/src/main-embed.tsx",
    "vendor/joola-b2b-live/src/App.tsx",
    "vendor/joola-b2b-live/src/AppEmbed.tsx",
    "vendor/joola-b2b-live/src/AppQo.tsx",
    "vendor/joola-b2b-live/src/embed/**",
    "vendor/joola-b2b-live/src/prototypes/quick-order-row/QuickOrderRowHarness.tsx",
    "vendor/joola-b2b-live/src/prototypes/approval-queue/ApprovalQueueHarness.tsx",
    "vendor/joola-b2b-live/src/components/PlaygroundDial.tsx",
    "vendor/joola-b2b-live/src/prototypes/quick-order-row/QuickOrderDial.tsx"
  ]
}
